# ============================================================
#  Variables de entorno SOLO para desarrollo (pnpm dev)
# ============================================================
#  Vite carga este archivo automáticamente con "pnpm dev".
#  Solo las variables que empiezan con VITE_ llegan al navegador
#  (es una protección: así no expones secretos por accidente).
#  NUNCA pongas contraseñas ni claves aquí: todo lo VITE_ es público.

# true  → el login aparece, pero "Entrar" funciona con los campos vacíos
# false → el login pide las credenciales de prueba (admin@multiaz.dev / Admin123!)
VITE_DEV_OPEN_LOGIN=true
